# Script mode: cmake -DOUTPUT=<file.cpp> -DFILES=<a|b|...> -P EmbedFiles.cmake
# Writes tesworld::gpu::detail::EmbeddedShader(name), the bytes of each file by its file name.
string(REPLACE "|" ";" _files "${FILES}")
set(_arrays "")
set(_lookups "")
set(_index 0)
foreach(_file IN LISTS _files)
	get_filename_component(_name "${_file}" NAME)
	file(READ "${_file}" _hex HEX)
	string(LENGTH "${_hex}" _length)
	if(_length EQUAL 0)
		message(FATAL_ERROR "EmbedFiles: ${_file} is empty")
	endif()
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
	string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" _bytes "${_bytes}")
	string(APPEND _arrays "\t\talignas(4) const unsigned char kFile${_index}[] = {\n${_bytes}\n\t\t};\n")
	string(APPEND _lookups "\t\tif (a_name == \"${_name}\") return { reinterpret_cast<const std::byte*>(kFile${_index}), sizeof(kFile${_index}) };\n")
	math(EXPR _index "${_index} + 1")
endforeach()
file(WRITE "${OUTPUT}.tmp" "// Generated by tesworld's cmake/EmbedFiles.cmake: the compiled shaders.\n#include <cstddef>\n#include <span>\n#include <string_view>\n\nnamespace tesworld::gpu::detail\n{\n\tnamespace\n\t{\n${_arrays}\t}\n\n\tstd::span<const std::byte> EmbeddedShader(std::string_view a_name)\n\t{\n${_lookups}\t\treturn {};\n\t}\n}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
